<group name="syslog,eset,eset_protect,">

  <!-- Basisregel für alle ESET-Protect-Ereignisse -->
  <rule id="400001" level="0">
    <decoded_as>eset-protect</decoded_as>
    <description>ESET Protect event</description>
  </rule>

  <!-- ===================== Audit_Event ===================== -->

  <!-- Allgemeines Audit-Ereignis -->
  <rule id="400010" level="5">
    <if_sid>400001</if_sid>
    <field name="event_type">^Audit_Event$</field>
    <description>ESET Protect audit event: $(action) by $(user)</description>
  </rule>

  <!-- Erfolgreicher Login -->
  <rule id="400011" level="5">
    <if_sid>400010</if_sid>
    <field name="action">^Login attempt$</field>
    <field name="result">^Success$</field>
    <description>ESET Protect: Successful login by $(user)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,pci_dss_10.2.5,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,tsc_CC6.8,</group>
  </rule>

  <!-- Fehlgeschlagener Login -->
  <rule id="400012" level="7">
    <if_sid>400010</if_sid>
    <field name="action">^Login attempt$</field>
    <field name="result" negate="yes">^Success$</field>
    <description>ESET Protect: Failed login attempt for $(user)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,tsc_CC6.8,</group>
  </rule>

  <!-- Mehrfach fehlgeschlagene Logins desselben Kontos: mögliche Brute-Force-Attacke gegen die AV-Konsole -->
  <rule id="400013" level="10" frequency="5" timeframe="120" ignore="120" overwrite="yes">
    <if_matched_sid>400012</if_matched_sid>
    <same_field>user</same_field>
    <description>ESET Protect: Multiple failed login attempts for $(user) - possible brute force against the AV management console</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,gpg13_7.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,</group>
  </rule>

  <!-- Logout -->
  <rule id="400014" level="5">
    <if_sid>400010</if_sid>
    <field name="action">^Logout$</field>
    <description>ESET Protect: User $(user) logged out</description>
  </rule>

  <!-- SSO-Token ausgestellt -->
  <rule id="400015" level="5">
    <if_sid>400010</if_sid>
    <field name="action">^Single sign on token issue$</field>
    <description>ESET Protect: SSO token issued for $(user)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <!-- Fehlgeschlagenes ESET-Ereignis unabhängig von der Aktion (schließt bereits abgedeckte Actions aus, um Doppelalarme mit 400012 zu vermeiden) -->
  <rule id="400016" level="5">
    <if_sid>400010</if_sid>
    <field name="action" negate="yes">^(Login attempt|Logout|Single sign on token issue)$</field>
    <field name="result" negate="yes">^Success$</field>
    <description>ESET Protect operation failed: $(action), user: $(user), result: $(result)</description>
  </rule>

  <!-- ===================== Threat_Event (AV-Erkennungen) =====================
       Felder verifiziert gegen die offizielle ESET-PROTECT-Dokumentation
       (help.eset.com, "Events exported to JSON format"). -->

  <rule id="400020" level="5">
    <if_sid>400001</if_sid>
    <field name="event_type">^Threat_Event$</field>
    <description>ESET Protect: Threat detected - $(threat_name) ($(threat_type)) on $(hostname), action: $(action_taken)</description>
    <group>malware,</group>
  </rule>

  <!-- Bedrohung erfolgreich bereinigt/entfernt -->
  <rule id="400021" level="5">
    <if_sid>400020</if_sid>
    <field name="threat_handled">^true$</field>
    <description>ESET Protect: Threat handled/cleaned - $(threat_name) on $(hostname)</description>
    <group>malware,</group>
  </rule>

  <!-- Bedrohung NICHT bereinigt: aktive, unbehandelte Infektion -->
  <rule id="400022" level="10">
    <if_sid>400020</if_sid>
    <field name="threat_handled">^false$</field>
    <description>ESET Protect: UNHANDLED threat $(threat_name) ($(threat_type)) on $(hostname) - manual remediation required (last action: $(action_taken))</description>
    <group>malware,pci_dss_5.1,pci_dss_5.2,nist_800_53_SI.3,</group>
  </rule>

  <!-- ===================== FirewallAggregated_Event ===================== -->

  <rule id="400030" level="5">
    <if_sid>400001</if_sid>
    <field name="event_type">^FirewallAggregated_Event$</field>
    <description>ESET Protect Firewall: $(event) $(source_address):$(source_port) -> $(target_address):$(target_port)/$(protocol) on $(hostname)</description>
  </rule>

  <!-- Eingehender Verbindungsversuch mit benannter Bedrohung/CVE: möglicher Exploit-Versuch -->
  <rule id="400031" level="8">
    <if_sid>400030</if_sid>
    <field name="inbound">^true$</field>
    <field name="threat_name">.+</field>
    <description>ESET Protect Firewall: possible exploitation attempt against $(hostname) - $(threat_name) from $(source_address)</description>
    <mitre>
      <id>T1210</id>
    </mitre>
    <group>attacks,pci_dss_11.4,nist_800_53_SI.4,</group>
  </rule>

  <!-- ===================== HipsAggregated_Event ===================== -->

  <rule id="400040" level="5">
    <if_sid>400001</if_sid>
    <field name="event_type">^HipsAggregated_Event$</field>
    <description>ESET Protect HIPS: $(operation) - $(application) -> $(target) on $(hostname), action: $(action)</description>
    <group>malware,</group>
  </rule>

  <rule id="400041" level="5">
    <if_sid>400040</if_sid>
    <field name="action">^blocked$</field>
    <description>ESET Protect HIPS: blocked - $(operation): $(application) on $(hostname)</description>
    <group>malware,</group>
  </rule>

  <!-- HIPS hat verdächtiges Verhalten erkannt, aber NICHT blockiert -->
  <rule id="400042" level="9">
    <if_sid>400040</if_sid>
    <field name="action" negate="yes">^blocked$</field>
    <description>ESET Protect HIPS: suspicious behavior NOT blocked - $(operation): $(application) on $(hostname)</description>
    <group>malware,</group>
  </rule>

  <!-- Spezialfall: blockierter Ausführungsversuch eines verdächtigen Objekts -->
  <rule id="400043" level="6">
    <if_sid>400041</if_sid>
    <field name="operation">run|execut</field>
    <description>ESET Protect HIPS: blocked attempt to execute a suspicious object - $(application) on $(hostname)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
    <group>malware,</group>
  </rule>

  <!-- ===================== FilteredWebsites_Event ===================== -->

  <rule id="400050" level="5">
    <if_sid>400001</if_sid>
    <field name="event_type">^FilteredWebsites_Event$</field>
    <description>ESET Protect Web filter: $(event) - $(object_uri) by $(username)</description>
    <group>web,</group>
  </rule>

  <rule id="400051" level="6">
    <if_sid>400050</if_sid>
    <field name="action_taken">^blocked$</field>
    <description>ESET Protect Web filter: blocked access to $(object_uri) by $(username) ($(rule_id))</description>
    <mitre>
      <id>T1071.001</id>
    </mitre>
    <group>web,</group>
  </rule>

  <!-- ===================== EnterpriseInspectorAlert_Event (ESET Inspect / EDR) =====================
       Kein vollständiges Beispiel-Payload in der Doku verfügbar, nur Feldliste -
       Regel entsprechend zurückhaltend gehalten. -->

  <rule id="400060" level="8">
    <if_sid>400001</if_sid>
    <field name="event_type">^EnterpriseInspectorAlert_Event$</field>
    <description>ESET Inspect (EDR) alert: $(rulename) - process $(processname) by $(username), severity score $(severity_score)</description>
    <group>malware,</group>
  </rule>

  <!-- ===================== BlockedFiles_Event =====================
       Ebenfalls ohne vollständiges Beispiel-Payload in der Doku - nur Basisregel. -->

  <rule id="400070" level="6">
    <if_sid>400001</if_sid>
    <field name="event_type">^BlockedFiles_Event$</field>
    <description>ESET Protect: File blocked - $(object_uri) ($(cause)), process: $(processname), user: $(username)</description>
    <group>malware,</group>
  </rule>

  <!-- ===================== Unbekannter/neuer event_type =====================
       Fängt event_type-Werte auf, die (noch) nicht oben klassifiziert sind - z.B. falls
       ESET künftig neue Event-Typen einführt. Bewusst am Ende/mit hoher ID, damit alle
       bekannten Typen zuerst geprüft werden. -->

  <rule id="400099" level="3">
    <if_sid>400001</if_sid>
    <field name="event_type" negate="yes">^(Audit_Event|Threat_Event|FirewallAggregated_Event|HipsAggregated_Event|FilteredWebsites_Event|EnterpriseInspectorAlert_Event|BlockedFiles_Event)$</field>
    <description>ESET Protect event (event_type: $(event_type)) - dedicated classification pending sample logs</description>
  </rule>

</group>
